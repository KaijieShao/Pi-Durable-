[Unit]
Conflicts=pi-durable-watchdog.service pi-durable-acceptance-watchdog.service pi-durable-acceptance-s2-watchdog.service pi-durable-acceptance-s3-watchdog.service
StartLimitIntervalSec=0
Description=Pi Durable watchdog (independent stop path: the Pi slice and the labelled containers)
Wants=docker.service
After=docker.service
Before=pi-durable-workshop-coordinator.service
RequiresMountsFor=/var/lib/pi-durable-workshop
[Service]
Type=simple
User=pi-watchdog
Group=pi-watchdog
SupplementaryGroups=docker
EnvironmentFile=/opt/pi-durable-workshop/watchdog.env
Environment={{unit:WATCHDOG_ENV_1}}
ExecStart=/usr/bin/node /opt/pi-durable/src/cli/main.ts watchdog
Restart=always
RestartSec=1
RestartPreventExitStatus=2
TimeoutStopSec=30
AmbientCapabilities=CAP_KILL
CapabilityBoundingSet=CAP_KILL
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pi-durable-workshop
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
StateDirectory=pi-durable-workshop-watchdog
StateDirectoryMode=0700
Environment={{unit:WATCHDOG_ENV_2}}
UMask=0007
MemoryMax=256M
TasksMax=64
[Install]
WantedBy=multi-user.target
