// Workshop Demo's persistent GCP entry. Credential values stay in memory.
import { readFileSync } from "node:fs";
import { runCoordinatorCli } from "/opt/pi-durable/src/cli/run.ts";
import { coordinatorEnvironment } from "/opt/pi-durable/deploy/gcp/environment.ts";

async function start() {
  const env = coordinatorEnvironment(process.env);
  if (readFileSync("/opt/pi-durable/.deployed-commit", "utf8").trim() !== {{json:SOURCE_SHA}} ||
      env.GITHUB_REPO !== {{json:EXPECTED_GITHUB_REPO}} ||
      env.TELEGRAM_GROUP_CHAT_ID !== {{json:EXPECTED_TELEGRAM_GROUP_CHAT_ID}} || env.TELEGRAM_GROUP_TOPIC_ID !== {{json:EXPECTED_TELEGRAM_GROUP_TOPIC_ID}} ||
      env.PI_DATA_DIR !== {{json:EXPECTED_PI_DATA_DIR}} || env.PI_TASK_DIR !== {{json:EXPECTED_PI_TASK_DIR}} ||
      env.PI_RUNNER_ISOLATION !== {{json:EXPECTED_PI_RUNNER_ISOLATION}}) throw Error("workshop_binding_invalid");
  const identityResponse = await fetch("http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token", {
    headers: { "Metadata-Flavor": "Google" }, signal: AbortSignal.timeout(10000),
  });
  if (!identityResponse.ok) throw Error("metadata_identity_unavailable");
  const identity = await identityResponse.json();
  for (const [name, id, version] of [
    ["TELEGRAM_BOT_TOKEN", {{json:TELEGRAM_SECRET}}, {{json:TELEGRAM_VERSION}}],
    ["GITHUB_TOKEN", {{json:GITHUB_SECRET}}, {{json:GITHUB_VERSION}}],
    ["OPENAI_API_KEY", {{json:MODEL_SECRET}}, {{json:MODEL_VERSION}}],
  ]) {
    const response = await fetch(`https://secretmanager.googleapis.com/v1/projects/{{word:PROJECT}}/secrets/${id}/versions/${version}:access`, {
      headers: { Authorization: `Bearer ${identity.access_token}` }, signal: AbortSignal.timeout(10000),
    });
    if (!response.ok) throw Error("credential_unavailable");
    const value = await response.json();
    env[name] = Buffer.from(value.payload.data, "base64").toString("utf8").trim();
    if (!env[name]) throw Error("credential_empty");
  }
  process.stdout.write('workshop_credentials_loaded github_secret={{word:GITHUB_SECRET}} version={{word:GITHUB_VERSION}} values_logged=false\n');
  return runCoordinatorCli({ env,
    start: async (config, deps) => (await import("/opt/pi-durable/src/coordinator/coordinator.ts")).startCoordinator(config, deps),
  });
}

start().then(result => { if (typeof result === "number") process.exitCode = result; }, () => {
  process.stderr.write("workshop_start_failed; credential values and raw errors suppressed\n");
  process.exitCode = 1;
});
