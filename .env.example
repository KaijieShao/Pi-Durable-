# Required: create a bot with @BotFather, then allow only your own numeric Telegram user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Optional: explicitly enable one group/topic. Keep Telegram privacy mode enabled.
# TELEGRAM_GROUP_CHAT_ID=-1001234567890
# TELEGRAM_GROUP_TOPIC_ID=1
# TELEGRAM_BOT_USERNAME=your_bot

# Defaults match the project's supported model catalog.
PI_PROVIDER=anthropic
PI_MODEL=claude-opus-5-5
PI_THINKING=high
ANTHROPIC_API_KEY=

# Alternative: OpenAI-compatible gateway (replace PI_PROVIDER/PI_MODEL above).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-gateway.example/v1
# OPENAI_CODEX_GATEWAY=1

# Optional: voice transcription and plugins.
# DEEPGRAM_API_KEY=
# PI_PLUGINS=skills
# PI_AUTH_FILE=/absolute/path/to/pi/agent/auth.json
# PI_DATA_DIR=/absolute/path/to/private/conversations
