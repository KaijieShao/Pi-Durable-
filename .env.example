# pi-durable-telegram group Coordinator: settings for one Telegram group, one GitHub repository and one model.
# Copy to a private, git-ignored file and fill it in (see RUN-LOCAL.md):
#   cp .env.example .env.local && chmod 600 .env.local
# Never commit real values, never paste tokens into the group, never show this file on screen while recording.
# Real environment variables win over this file. Invalid or missing values stop the Coordinator at start with one
# line per problem (exit code 2); values are never printed.

# --- Telegram --------------------------------------------------------------------------------------------------

# Required, secret. The bot token from @BotFather (/mybots -> the bot -> API Token).
TELEGRAM_BOT_TOKEN=
# Required. The bot's exact username without "@"; checked against Telegram's getMe at start.
TELEGRAM_BOT_USERNAME=smule_code_bot
# Required. The one group the Coordinator serves: a negative number (supergroups look like -100...). Every other
# chat is ignored. To find it, send /help@smule_code_bot in the group and read chat.id from getUpdates as described
# in RUN-LOCAL.md ("Find the group chat id and your user id"); print only the ids, never the token.
TELEGRAM_GROUP_CHAT_ID=
# Optional. Forum topic (message_thread_id) the Coordinator listens and answers in. Default 1 = General, or a group
# without topics.
# TELEGRAM_GROUP_TOPIC_ID=1
# Required. The group owner's numeric Telegram user id (from.id of your own message). The owner may cancel, follow up
# and approve any task, and runs the owner CLI.
TELEGRAM_OWNER_ID=
# Optional. Comma-separated numeric user ids allowed to submit /task (the owner always may). Unset = any member of
# the configured group. Follow-ups, /approve and /cancel are always limited to the task's creator and the owner.
# TELEGRAM_MEMBER_IDS=111111111,222222222
# Optional, advanced. Bot API server; tests point it at a local fake.
# TELEGRAM_API_ROOT=https://api.telegram.org

# --- Agents and model --------------------------------------------------------------------------------------------

# Required. The group's agent ids, comma-separated: lower-case letter first, then letters, digits, - or _, at most
# 32 characters, unique. Used as /task@smule_code_bot <agent> <text>.
PI_AGENTS=alpha,beta
# Must be openai (the default): Pi reaches the model only through the Coordinator's local OpenAI-compatible relay.
PI_PROVIDER=openai
# Required. The pinned model id from the pi-ai "openai" catalog, e.g. gpt-5.5.
PI_MODEL=gpt-5.5
# Optional. off, minimal, low, medium, high, xhigh or max; checked against the model. Default medium.
PI_THINKING=medium
# Required, secret. The real model key. Only the relay inside the Coordinator holds it; Pi processes get a run key
# that works only while their run is open, and containers get nothing.
OPENAI_API_KEY=
# Optional. Where the relay forwards model requests (an OpenAI Responses-compatible endpoint): HTTPS, or HTTP only on
# localhost/127.0.0.1/[::1]; no credentials, query or fragment in the URL. Default https://api.openai.com/v1.
# OPENAI_BASE_URL=https://your-gateway.example/v1
# Optional. Set to 1 only when OPENAI_BASE_URL is a gateway backed by the Codex subscription API (top-level
# instructions, streamed responses, unsupported sampling/cache settings removed).
# OPENAI_CODEX_GATEWAY=1
# Required. The owner-set project token ceiling for the budget ledger. Before each model request the relay reserves
# the full 48,000-token input allowance plus 16,000 output tokens (64,000) against it; reported usage replaces the
# reservation afterwards, unknown usage keeps it. Leave room for 2 concurrent runs (2 x 64,000) above what is spent.
PROJECT_TOKEN_CEILING=3000000

# --- GitHub ------------------------------------------------------------------------------------------------------

# Required, secret. A fine-grained personal access token limited to the one test repository, with repository
# permissions Contents: Read and write and Pull requests: Read and write (Metadata: Read-only is added
# automatically). Nothing else: no Administration, no Workflows, no other repositories.
GITHUB_TOKEN=
# Required. The test repository, owner/name. main must require pull requests and "Require branches to be up to date
# before merging" (RUN-LOCAL.md, "GitHub test repository").
GITHUB_REPO=
# Optional. The base branch tasks start from and merge into. Default main.
GITHUB_BASE_BRANCH=main
# Optional, advanced: GitHub REST endpoint, task branch prefix (task/12), checkpoint commit author.
# GITHUB_API_URL=https://api.github.com
# GIT_BRANCH_PREFIX=task/
# GIT_AUTHOR_NAME=pi-durable coordinator
# GIT_AUTHOR_EMAIL=pi-durable-coordinator@users.noreply.github.com

# --- Storage -----------------------------------------------------------------------------------------------------

# Optional. Coordinator SQLite, one Pi SQLite file per conversation, lock, and owner/ (the owner CLI's socket, 0700)
# (mode 700; 0710 with systemd isolation). The owner socket's path must fit in 103 bytes (107 on Linux).
# Default ~/.local/state/pi-durable-coordinator. Relative paths are resolved from the current directory.
# PI_DATA_DIR=/Users/you/.local/state/pi-durable-coordinator
# Optional. The task disk: the git repository, one worktree per open task, check scratch space. It must be inside a
# folder Docker Desktop shares (Settings -> Resources -> File sharing; /Users is shared by default).
# Default <PI_DATA_DIR>/tasks.
# PI_TASK_DIR=/Users/you/.local/state/pi-durable-coordinator/tasks
# Optional, servers only: set to 1 to refuse to start unless PI_TASK_DIR is a mount point (the GCP task disk).
# PI_REQUIRE_TASK_MOUNT=1
# Optional, servers only: the group the database and the lock file are shared with, so the watchdog runs as its own
# user (docs/security.md "The watchdog"). Unset (on a Mac): both stay owner-only and the watchdog runs as you.
# PI_STATE_GROUP=pi-watchdog

# Disk limits (docs/configuration.md "Disk limits"). Sizes in bytes or with K, M, G, T (powers of 1024).
# Optional. A new /task is rejected while the boot disk (PI_DATA_DIR's filesystem: database, Pi stores) has less
# free than this. Default 1GiB.
# PI_BOOT_DISK_MIN_FREE=1GiB
# Optional. A new worktree is created only if at least this much stays free on the task disk after it; otherwise
# the task stays queued and the bot says why. Default 1GiB.
# PI_TASK_DISK_MIN_FREE=1GiB
# Optional. A budget for the task disk: a new worktree is created only if the task disk's usage plus the new
# worktree stays within it (usage: the filesystem's when PI_TASK_DIR is a mount point, else everything under
# PI_TASK_DIR). Unset: the task disk's own size is the budget (only PI_TASK_DISK_MIN_FREE applies).
# PI_TASK_DISK_BUDGET=20GiB
# Optional. Room a new worktree is assumed to need beyond its checked-out files (dependencies, build output).
# Default 1GiB.
# PI_WORKTREE_HEADROOM=1GiB

# The watchdog (node src/cli/main.ts watchdog --env-file <this file>) reads only PI_DATA_DIR,
# TELEGRAM_GROUP_CHAT_ID, DOCKER_BIN, PI_RUNNER_ISOLATION, PI_RUNNER_SLICE, SYSTEMCTL_BIN and LOG_LEVEL from it; every
# other line, the secrets included, is dropped before it is parsed. Start it before the Coordinator.

# --- Containers --------------------------------------------------------------------------------------------------

# Images built by scripts/build-images.sh. Agent containers run file operations; check containers run the fixed
# operations (setup, test, lint, build) listed in the check image. Both run with no network and no credentials.
AGENT_IMAGE=pi-durable-agent:demo
CHECK_IMAGE=pi-durable-check:demo
# Optional. uid:gid the containers run as; never root (uid 0 or gid 0 is refused). Default: the Coordinator's own
# uid:gid (65534:65534 if the Coordinator runs as root or with gid 0).
# CONTAINER_USER=501:20
# Optional. Path inside the repository of the checked-in setup script, run once per task in a check container with
# the worktree writable. Skipped if the file does not exist. Default .pi/setup.sh.
# PI_SETUP_SCRIPT=.pi/setup.sh
# Optional, advanced: the docker CLI, and the relay's 127.0.0.1 port (0 = any free port).
# DOCKER_BIN=docker
# RELAY_PORT=0

# --- Trial evaluation (owner seal) -------------------------------------------------------------------------------

# Optional. The hidden tests the isolated evaluator grades the sealed snapshot of main with (RUN-LOCAL.md, "Trial
# evaluation"): <dir>/modules/<module>/, <dir>/integration/, <dir>/baseline/, each with *.test.js files. Mounted
# read-only in the evaluator container only, never in an agent or check container; it must be outside PI_DATA_DIR and
# PI_TASK_DIR, readable by the Coordinator's user (it hashes them for the trial record) and CONTAINER_USER, not by the
# Pi user. Unset: owner seal is refused.
# PI_EVAL_HIDDEN_TESTS_DIR=/srv/pi-durable/hidden-tests
# The trusted evaluator image (built by scripts/build-images.sh): its launcher and fixed suite list grade the suites one
# after another, 2 vCPU / 2 GiB, no network, no credentials.
# EVALUATOR_IMAGE=pi-durable-evaluator:demo

# --- Pi processes ------------------------------------------------------------------------------------------------

# Optional. How each run's Pi process is isolated (docs/isolation.md). systemd (the default on Linux): a transient
# unit per run as its own unprivileged user in a dedicated slice, with a per-unit sandbox and loopback-only network;
# it needs the one-time host setup and refuses to run tasks without it. process (the default elsewhere, e.g. this
# Mac): a child process as your own user, without a separate user, slice or IP filter; the weaker local mode.
# PI_RUNNER_ISOLATION=process
# Optional, systemd isolation only: the Pi user (never root or the Coordinator's user), the group it shares with the
# Coordinator for the conversations directory, the slice, and the systemd CLIs.
# PI_RUNNER_USER=pi-runner
# PI_RUNNER_GROUP=pi-durable
# PI_RUNNER_SLICE=pi-durable-runs.slice
# SYSTEMD_RUN_BIN=systemd-run
# SYSTEMCTL_BIN=systemctl

# --- Logs --------------------------------------------------------------------------------------------------------

# Optional. debug, info, warn or error. Logs are metadata only (ids, counts, outcomes), never message text or secrets.
LOG_LEVEL=info
